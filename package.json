{
  "name": "summon",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Keyboard search across open tabs and bookmarks",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "npm run build && vitest run --config vitest.e2e.config.ts",
    "icons": "node scripts/icons.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "puppeteer": "^25.13.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "puppeteer@25.13.0": true
  }
}
