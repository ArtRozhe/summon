{
  "manifest_version": 3,
  "name": "Summon",
  "version": "0.1.0",
  "description": "Keyboard search across open tabs and bookmarks.",
  "minimum_chrome_version": "127",
  "permissions": [
    "tabs",
    "bookmarks",
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "Summon",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Space",
        "mac": "Command+Shift+Space"
      }
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
